# CiviSense Backend Environment Configuration
DATABASE_URL=sqlite:///./civisense.db
# To use PostgreSQL instead, uncomment below:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/civisense

# Groq API Key (Optional for zero-config test with heuristic fallback, required for Llama-3.3-70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
